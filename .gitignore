# Files this repository never tracks.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Log files
*.log

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.exe

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


# --- .NET build output --------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
.vs/
project.lock.json
artifacts/

# --- project conventions ------------------------------------------------------
# tests/ is tracked: 1549 live API cases with no mock layer. They read credentials at
# runtime from this repo's own .env (copy .env.example; nothing secret is committed).

# Local working area: parked artifacts, live-test drivers, notes.
/scratchpad/

# Credentials for live verification. Never committed.
.env
.env.*
!.env.example
